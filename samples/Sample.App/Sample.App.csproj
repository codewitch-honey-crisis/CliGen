<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>sample</AssemblyName>
    <AssemblyTitle>Cli.Generator sample</AssemblyTitle>
    <Description>Copies a text file, optionally changing its case. Shows ordinals, switches, lists, groups and usage.</Description>
    <Version>1.2.0</Version>
    <!-- Lets you open obj/.../generated to see what the generator wrote. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cli.Generator\Cli.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
